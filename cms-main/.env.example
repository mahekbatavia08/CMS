# ==========================================
# Server Configuration
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# Supabase (Database + Storage)
# Dashboard -> Project Settings -> API / API Keys
# ==========================================
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only key: "service_role" (legacy JWT) or "sb_secret_..." (new). NEVER put it in the client.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_secret_key_here
SUPABASE_STORAGE_BUCKET=cms-media
# "public" = own project (schema.sql) | "cms" = shared project (schema-cms.sql)
SUPABASE_DB_SCHEMA=public

# ==========================================
# Authentication
# ==========================================
JWT_SECRET=your_jwt_secret_here

# ==========================================
# Seed Script (used only by: npm run seed:admin)
# ==========================================
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345

# ==========================================
# One-time migration only (npm run migrate:mongo) — delete after migrating
# ==========================================
# MONGODB_URI=your_old_mongodb_atlas_connection_string
# LEGACY_UPLOADS_DIR=./uploads